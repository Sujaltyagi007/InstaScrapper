generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TargetAccountType {
  BUSINESS
  CREATOR
  PERSONAL
  UNKNOWN
}

enum TargetEligibility {
  SUPPORTED
  PARTIALLY_SUPPORTED
  UNSUPPORTED
  PRIVATE_UNAVAILABLE
  TEMPORARILY_UNAVAILABLE
}

enum TargetStatus {
  DISCOVERED
  ACTIVE
  PAUSED
  RATE_LIMITED
  BACKOFF
  AUTH_ERROR
  REAUTH_REQUIRED
  NOT_FOUND
  UNAVAILABLE
  UNSUPPORTED
  INVALID
}

enum MetaConnectionStatus {
  ACTIVE
  REAUTH_REQUIRED
  REVOKED
  ERROR
}

enum EventType {
  NEW_MEDIA
  MEDIA_UPDATED
  PROFILE_CHANGED
  FOLLOWER_COUNT_CHANGED
  FOLLOWING_COUNT_CHANGED
  NEW_STORY
  NEW_REEL
  FOLLOWER_CHURN
  COLLAB_POST_LEAKED
  ACCOUNT_UNAVAILABLE
  ACCOUNT_RENAMED
  RATE_LIMITED
  SESSION_FLAGGED
}

enum EventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum JobType {
  TARGET_CHECK
  NOTIFICATION_DISPATCH
  RETENTION_CLEANUP
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  passwordHash          String
  name                  String?
  timezone              String                @default("UTC")
  retentionDays         Int                   @default(90)
  role                  String                @default("USER")
  maxTargets            Int                   @default(10)
  targetQuotaAlertLevel String?
  sleepEnabled          Boolean               @default(true)
  sleepStartHour        Int                   @default(1)
  sleepEndHour          Int                   @default(7)
  accentColor           String?
  mediaKeepHours        Int?                  @default(48)
  emailVerified         DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  metaConnections       MetaConnection[]
  igAccounts            IgAccount[]
  niches                Niche[]
  reelProjects          ReelProject[]
  soundAssets           SoundAsset[]
  storedFiles           StoredFile[]
  instagramSessions     InstagramSession[]
  homeWorkerDevices     HomeWorkerDevice[]
  targets               Target[]
  notificationChannels  NotificationChannel[]
  authRateLimits        AuthRateLimit[]
  pushSubscriptions     PushSubscription[]
  aiKeys                AIKey[]

  @@map("users")
}

model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  label         String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  failureCount  Int       @default(0)

  @@index([userId])
  @@map("push_subscriptions")
}

model MetaConnection {
  id                   String               @id @default(cuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             String               @default("meta")
  externalUserId       String
  accountType          String?
  igUsername           String?
  pageId               String?
  encryptedAccessToken String
  encryptedTokenIv     String
  scopes               String[]
  status               MetaConnectionStatus @default(ACTIVE)
  expiresAt            DateTime?
  lastVerifiedAt       DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([userId])
  @@map("meta_connections")
}

model IgAccount {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  igUserId             String
  username             String?
  accountType          String?
  encryptedAccessToken String
  encryptedTokenIv     String
  scopes               String[]
  status               String    @default("ACTIVE")
  tokenExpiresAt       DateTime?
  tokenRefreshedAt     DateTime  @default(now())
  postingPaused        Boolean   @default(false)
  pausedReason         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, igUserId])
  @@map("ig_accounts")
}

model MediaMetricSnapshot {
  id           String   @id @default(cuid())
  mediaId      String
  media        Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  playCount    Int?
  likeCount    Int?
  commentCount Int?
  capturedAt   DateTime @default(now())

  @@index([mediaId, capturedAt])
  @@map("media_metric_snapshots")
}

model Niche {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  language    String         @default("en")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  accounts    NicheAccount[]
  ideas       ReelIdea[]

  @@index([userId])
  @@map("niches")
}

model ReelIdea {
  id             String       @id @default(cuid())
  nicheId        String
  niche          Niche        @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  title          String
  angle          String
  hook           String
  whyTrending    String
  score          Float
  sourceMediaIds String[]
  status         String       @default("SUGGESTED")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  project        ReelProject?

  @@index([nicheId, status, createdAt])
  @@map("reel_ideas")
}

model ReelProject {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ideaId         String    @unique
  idea           ReelIdea  @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  stage          String    @default("SCRIPT")
  failedStage    String?
  script         Json?
  voiceUrl       String?
  voiceFileId    String?
  voiceTiming    Json?
  audioBlueprint Json?
  mixUrl         String?
  mixFileId      String?
  clips          Json?
  renderUrl      String?
  renderFileId   String?
  coverUrl       String?
  coverFileId    String?
  qualityScore   Int?
  qualityReport  Json?
  claimsReport   Json?
  caption        String?
  hashtags       String[]  @default([])
  scheduledFor   DateTime?
  sentAt         DateTime?
  postedAt       DateTime?
  postedUrl      String?
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lockedUntil    DateTime?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([stage, nextAttemptAt])
  @@index([userId, createdAt])
  @@map("reel_projects")
}

model StoredFile {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId         String   @unique
  url            String
  kind           String
  label          String?
  targetId       String?
  target         Target?  @relation(fields: [targetId], references: [id], onDelete: SetNull)
  targetUsername String?
  contentType    String?
  sizeBytes      Int?
  contentHash    String?
  visualHash     String?
  createdAt      DateTime @default(now())

  @@index([userId, kind])
  @@index([targetId, kind, contentHash])
  @@map("stored_files")
}

model SoundAsset {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  source        String?
  licenseUrl    String?
  moodTags      String[] @default([])
  bpm           Int?
  energy        String?
  description   String?
  durationMs    Int
  storageUrl    String
  storageFileId String
  createdAt     DateTime @default(now())

  @@index([userId, kind])
  @@map("sound_assets")
}

model NicheAccount {
  id        String   @id @default(cuid())
  nicheId   String
  niche     Niche    @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  targetId  String
  target    Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  source    String   @default("USER")
  createdAt DateTime @default(now())

  @@unique([nicheId, targetId])
  @@index([targetId])
  @@map("niche_accounts")
}

model Target {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  username            String
  normalizedUsername  String
  externalId          String?
  accountType         TargetAccountType @default(UNKNOWN)
  eligibility         TargetEligibility @default(UNSUPPORTED)
  status              TargetStatus      @default(DISCOVERED)
  errorCode           String?
  errorMessage        String?
  nextRunAt           DateTime?
  lastCheckedAt       DateTime?
  lastSuccessAt       DateTime?
  consecutiveFailures Int               @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  monitor       Monitor?
  snapshots     TargetSnapshot[]
  media         Media[]
  events        Event[]
  jobs          Job[]
  nicheAccounts NicheAccount[]
  storedFiles   StoredFile[]

  @@unique([userId, normalizedUsername])
  @@index([userId])
  @@index([status, nextRunAt])
  @@map("targets")
}

model InstagramSession {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  username           String
  authMethod         String            @default("COOKIE_IMPORT")
  encryptedCookies   String
  encryptedCookiesIv String
  userAgent          String?
  deviceId           String?
  impersonateTarget  String            @default("auto")
  proxyUrl           String?
  proxyUrlIv         String?
  status             String            @default("ACTIVE")
  lastTestedAt       DateTime?
  lastSuccessAt      DateTime?
  lastErrorMessage   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lastUsedAt         DateTime?
  cooldownUntil      DateTime?
  usesToday          Int               @default(0)
  usesDay            String?
  monitors           Monitor[]
  transport          String            @default("PROXY")
  homeWorkerDeviceId String?
  homeWorkerDevice   HomeWorkerDevice? @relation(fields: [homeWorkerDeviceId], references: [id], onDelete: SetNull)
  homeWorkerJobs     HomeWorkerJob[]

  @@index([userId])
  @@index([userId, status, lastUsedAt])
  @@map("instagram_sessions")
}

model HomeWorkerDevice {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  tokenHash  String    @unique
  status     String    @default("ACTIVE") // ACTIVE | REVOKED
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  sessions InstagramSession[]
  jobs     HomeWorkerJob[]

  @@index([userId])
  @@map("home_worker_devices")
}

model HomeWorkerJob {
  id              String           @id @default(cuid())
  deviceId        String
  device          HomeWorkerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sessionId       String
  session         InstagramSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status          String           @default("PENDING") // PENDING | CLAIMED | DONE | FAILED | EXPIRED
  requestPayload  Json
  responsePayload Json?
  createdAt       DateTime         @default(now())
  claimedAt       DateTime?
  expiresAt       DateTime

  @@index([deviceId, status, createdAt])
  @@map("home_worker_jobs")
}

model Monitor {
  id                     String            @id @default(cuid())
  targetId               String            @unique
  target                 Target            @relation(fields: [targetId], references: [id], onDelete: Cascade)
  userId                 String
  engineType             String            @default("STEALTH_SCRAPER")
  triggerMode            String            @default("NEW_POSTS_ONLY")
  purpose                String            @default("MONITOR")
  watchNewMedia          Boolean           @default(true)
  watchProfile           Boolean           @default(true)
  watchFollowerCount     Boolean           @default(false)
  watchFollowingCount    Boolean           @default(false)
  watchStories           Boolean           @default(true)
  watchReels             Boolean           @default(true)
  watchFollowerChurn     Boolean           @default(false)
  watchCollabPosts       Boolean           @default(true)
  autoRepost             Boolean           @default(false)
  jitterEnabled          Boolean           @default(true)
  humanSimEnabled        Boolean           @default(false)
  restrictedHoursEnabled Boolean           @default(false)
  restrictedHoursStart   Int               @default(8)
  restrictedHoursEnd     Int               @default(23)
  instagramSessionId     String?
  instagramSession       InstagramSession? @relation(fields: [instagramSessionId], references: [id], onDelete: SetNull)
  followerThreshold      Int?
  intervalSeconds        Int               @default(5400)
  active                 Boolean           @default(true)
  notificationChannelIds String[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([instagramSessionId])
  @@map("monitors")
}

model TargetSnapshot {
  id                       String    @id @default(cuid())
  targetId                 String
  target                   Target    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  capturedAt               DateTime  @default(now())
  username                 String
  name                     String?
  biography                String?
  website                  String?
  profilePictureUrl        String?
  profilePictureStorageUrl String?
  profilePictureStorageId  String?
  followersCount           Int?
  followsCount             Int?
  mediaCount               Int?
  reelsCount               Int?
  hasStory                 Boolean   @default(false)
  storiesCount             Int?
  latestMediaId            String?
  latestMediaTimestamp     DateTime?
  followersListHash        String?
  followingListHash        String?
  followersListJson        Json?
  followingListJson        Json?
  rawHash                  String

  @@index([targetId, capturedAt])
  @@map("target_snapshots")
}

model Media {
  id               String                @id @default(cuid())
  targetId         String
  target           Target                @relation(fields: [targetId], references: [id], onDelete: Cascade)
  externalMediaId  String
  mediaType        String
  permalink        String?
  timestamp        DateTime?
  caption          String?
  mediaUrl         String?
  videoUrl         String?
  sourceMediaUrl   String?
  sourceVideoUrl   String?
  storageUrl       String?
  storageFileId    String?
  storedAt         DateTime?
  thumbnailUrl     String?
  thumbnailFileId  String?
  isExpired        Boolean               @default(false)
  expiredAt        DateTime?
  isStory          Boolean               @default(false)
  isCollab         Boolean               @default(false)
  collaborators    String[]              @default([])
  firstSeenAt      DateTime              @default(now())
  playCount        Int?
  likeCount        Int?
  commentCount     Int?
  audioTitle       String?
  audioArtist      String?
  audioIsOriginal  Boolean?
  metricsUpdatedAt DateTime?
  metricSnapshots  MediaMetricSnapshot[]
  assets           MediaAsset[]

  @@unique([targetId, externalMediaId])
  @@index([targetId])
  @@index([isExpired, storedAt])
  @@map("media")
}

model MediaAsset {
  id              String   @id @default(cuid())
  mediaId         String
  media           Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  position        Int
  isVideo         Boolean  @default(false)
  sourceUrl       String?
  storageUrl      String?
  storageFileId   String?
  thumbnailUrl    String?
  thumbnailFileId String?
  createdAt       DateTime @default(now())

  @@unique([mediaId, position])
  @@index([mediaId])
  @@map("media_assets")
}

model Event {
  id          String      @id @default(cuid())
  targetId    String
  target      Target      @relation(fields: [targetId], references: [id], onDelete: Cascade)
  userId      String
  type        EventType
  fingerprint String
  before      Json?
  after       Json?
  detectedAt  DateTime    @default(now())
  processedAt DateTime?
  status      EventStatus @default(PENDING)

  notifications Notification[]

  @@unique([targetId, fingerprint])
  @@index([userId, detectedAt])
  @@index([targetId, detectedAt])
  @@map("events")
}

enum NotificationProvider {
  DISCORD
  NTFY
  WEBHOOK
  WEBPUSH
}

model NotificationChannel {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  provider          NotificationProvider
  encryptedConfig   String
  encryptedConfigIv String
  eventTypeFilter   EventType[]
  cooldownSeconds   Int                  @default(0)
  enabled           Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  notifications Notification[]

  @@index([userId])
  @@map("notification_channels")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

model Notification {
  id            String               @id @default(cuid())
  eventId       String
  event         Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channelId     String
  channel       NotificationChannel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  provider      NotificationProvider
  status        NotificationStatus   @default(PENDING)
  attempts      Int                  @default(0)
  nextAttemptAt DateTime?
  sentAt        DateTime?
  error         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([eventId, channelId])
  @@index([status, nextAttemptAt])
  @@index([channelId])
  @@map("notifications")
}

model Job {
  id            String    @id @default(cuid())
  type          JobType
  targetId      String?
  target        Target?   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  status        JobStatus @default(QUEUED)
  attempts      Int       @default(0)
  runAt         DateTime  @default(now())
  lockedAt      DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  lastError     String?
  resultSummary String?

  @@index([type, status, runAt])
  @@index([targetId])
  @@map("jobs")
}

model AuthRateLimit {
  id           String    @id @default(cuid())
  key          String
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts     Int       @default(1)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?

  @@unique([key])
  @@map("auth_rate_limits")
}

model R2UsageCounter {
  id               String    @id @default("singleton")
  billingMonth     String
  aClassOps        Int       @default(0)
  bClassOps        Int       @default(0)
  storageBytesEst  BigInt    @default(0)
  lastReconciledAt DateTime?
  updatedAt        DateTime  @updatedAt

  @@map("r2_usage_counters")
}

model ScrapeThrottle {
  id                   String    @id
  day                  String
  profileViews         Int       @default(0)
  consecutiveSoftFails Int       @default(0)
  pauseLevel           Int       @default(0)
  pausedUntil          DateTime?
  updatedAt            DateTime  @updatedAt

  @@map("scrape_throttle")
}

model Repost {
  id               String   @id @default(cuid())
  userId           String
  sourceMediaId    String?
  sessionId        String
  status           String   @default("PENDING")
  instagramMediaId String?
  caption          String?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([sourceMediaId, sessionId])
  @@map("reposts")
}

/// A user's API key for an AI or media provider (see lib/ai/keys.ts).
/// The key itself is encrypted: `key` holds ciphertext, `keyIv` its IV. Only
/// lib/ai/keys.ts may read or write it; the browser only ever sees `last4`.
model AIKey {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  /// Ciphertext (AES-256-GCM, lib/crypto.ts). Plain text only on rows from
  /// before encryption, which have no keyIv and are migrated on read.
  key            String
  keyIv          String?
  /// sha256 of the key, so a duplicate paste is caught without decrypting
  /// (checked in addUserKey; not a DB unique constraint, so pushing this
  /// schema never needs --accept-data-loss).
  fingerprint    String?
  last4          String    @default("")
  /// ACTIVE | INVALID (the provider rejected the key; skipped until re-checked).
  status         String    @default("ACTIVE")
  /// Out of quota until then; skipped by rotation, on every server instance.
  exhaustedUntil DateTime?
  /// Quota that runs out per model (Gemini): { "<model>": "<ISO time it resets>" }.
  /// The key keeps working for other models meanwhile.
  exhaustedScopes Json?
  lastError      String?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, provider])
  @@index([userId, fingerprint])
  @@map("ai_keys")
}
