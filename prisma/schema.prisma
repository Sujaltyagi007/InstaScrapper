generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TargetAccountType {
  BUSINESS
  CREATOR
  PERSONAL
  UNKNOWN
}

enum TargetEligibility {
  SUPPORTED
  PARTIALLY_SUPPORTED
  UNSUPPORTED
  PRIVATE_UNAVAILABLE
  TEMPORARILY_UNAVAILABLE
}

enum TargetStatus {
  DISCOVERED
  ACTIVE
  PAUSED
  RATE_LIMITED
  BACKOFF
  AUTH_ERROR
  REAUTH_REQUIRED
  NOT_FOUND
  UNAVAILABLE
  UNSUPPORTED
  INVALID
}

enum MetaConnectionStatus {
  ACTIVE
  REAUTH_REQUIRED
  REVOKED
  ERROR
}

enum EventType {
  NEW_MEDIA
  MEDIA_UPDATED
  PROFILE_CHANGED
  FOLLOWER_COUNT_CHANGED
  FOLLOWING_COUNT_CHANGED
  NEW_STORY
  NEW_REEL
  FOLLOWER_CHURN
  COLLAB_POST_LEAKED
  ACCOUNT_UNAVAILABLE
  ACCOUNT_RENAMED
  RATE_LIMITED
  SESSION_FLAGGED
}

enum EventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum JobType {
  TARGET_CHECK
  NOTIFICATION_DISPATCH
  RETENTION_CLEANUP
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  passwordHash          String
  name                  String?
  timezone              String                @default("UTC")
  retentionDays         Int                   @default(90)
  role                  String                @default("USER")
  maxTargets            Int                   @default(10)
  targetQuotaAlertLevel String?
  sleepEnabled          Boolean               @default(true)
  sleepStartHour        Int                   @default(1)
  sleepEndHour          Int                   @default(7)
  // How long full-size scraped media is kept before only the thumbnail remains. Null = until deleted by hand.
  mediaKeepHours        Int?                  @default(48)
  emailVerified         DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  metaConnections       MetaConnection[]
  igAccounts            IgAccount[]
  niches                Niche[]
  reelProjects          ReelProject[]
  soundAssets           SoundAsset[]
  storedFiles           StoredFile[]
  instagramSessions     InstagramSession[]
  targets               Target[]
  notificationChannels  NotificationChannel[]
  authRateLimits        AuthRateLimit[]
  pushSubscriptions     PushSubscription[]

  @@map("users")
}

/// One browser/device subscribed to Web Push. Delivered through the user's
/// WEBPUSH NotificationChannel (which holds the event-type preferences).
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  /// "Chrome on Windows" etc., derived from the user agent when subscribing.
  label         String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  failureCount  Int       @default(0)

  @@index([userId])
  @@map("push_subscriptions")
}

model MetaConnection {
  id                   String               @id @default(cuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             String               @default("meta")
  externalUserId       String
  accountType          String?
  igUsername           String?
  pageId               String?
  encryptedAccessToken String
  encryptedTokenIv     String
  scopes               String[]
  status               MetaConnectionStatus @default(ACTIVE)
  expiresAt            DateTime?
  lastVerifiedAt       DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([userId])
  @@map("meta_connections")
}

// The user's own posting account via Instagram Login (graph.instagram.com, no
// Facebook Page). Kept apart from MetaConnection (Facebook Login) because the
// two tokens only work on their own host and must never be mixed up.
model IgAccount {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  igUserId             String
  username             String?
  accountType          String?
  encryptedAccessToken String
  encryptedTokenIv     String
  scopes               String[]
  // ACTIVE | REAUTH_REQUIRED | ERROR
  status               String    @default("ACTIVE")
  tokenExpiresAt       DateTime?
  tokenRefreshedAt     DateTime  @default(now())
  // Kill switch: set when a posted reel disappears; nothing posts while true.
  postingPaused        Boolean   @default(false)
  pausedReason         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, igUserId])
  @@map("ig_accounts")
}

model MediaMetricSnapshot {
  id           String   @id @default(cuid())
  mediaId      String
  media        Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  playCount    Int?
  likeCount    Int?
  commentCount Int?
  capturedAt   DateTime @default(now())

  @@index([mediaId, capturedAt])
  @@map("media_metric_snapshots")
}

model Niche {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  language    String         @default("en")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  accounts    NicheAccount[]
  ideas       ReelIdea[]

  @@index([userId])
  @@map("niches")
}

model ReelIdea {
  id             String   @id @default(cuid())
  nicheId        String
  niche          Niche    @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  title          String
  angle          String
  hook           String
  whyTrending    String
  score          Float
  // Media ids of the trending reels this idea is based on (evidence, never reused as footage).
  sourceMediaIds String[]
  // SUGGESTED | APPROVED | DISMISSED
  status         String   @default("SUGGESTED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        ReelProject?

  @@index([nicheId, status, createdAt])
  @@map("reel_ideas")
}

// One reel being built from an approved idea. The pipeline advances it one
// stage per step (lib/services/reel-pipeline.service.ts), under a lease.
model ReelProject {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ideaId         String    @unique
  idea           ReelIdea  @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  // SCRIPT | VOICE | AUDIO_PLAN | VISUALS | SAFETY | RENDER | CAPTION | READY | POSTED | FAILED
  stage          String    @default("SCRIPT")
  // The stage to resume from when a FAILED project is retried.
  failedStage    String?
  script         Json?
  voiceUrl       String?
  voiceFileId    String?
  // { durationSec, spans: [{ start, end }] } — one span per script sentence.
  voiceTiming    Json?
  audioBlueprint Json?
  mixUrl         String?
  mixFileId      String?
  clips          Json?
  renderUrl      String?
  renderFileId   String?
  coverUrl       String?
  coverFileId    String?
  caption        String?
  hashtags       String[]  @default([])
  // Send to phone: when the push is due, and when it went out.
  scheduledFor   DateTime?
  sentAt         DateTime?
  postedAt       DateTime?
  postedUrl      String?
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lockedUntil    DateTime?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([stage, nextAttemptAt])
  @@index([userId, createdAt])
  @@map("reel_projects")
}

// Register of every file this app put in storage, per user (lib/storage/ledger.ts).
// Outlives its target (targetId is cleared, targetUsername stays), so files kept
// after deleting a target can still be found and managed on the Storage page.
model StoredFile {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId         String   @unique
  url            String
  // MEDIA | THUMBNAIL | STORY | PROFILE_PIC | REEL | SOUND | OTHER
  kind           String
  label          String?
  targetId       String?
  target         Target?  @relation(fields: [targetId], references: [id], onDelete: SetNull)
  targetUsername String?
  contentType    String?
  sizeBytes      Int?
  // sha1 of the bytes.
  contentHash    String?
  // Perceptual hash (16x16 grayscale average hash, hex) for images. Instagram
  // serves the same profile picture in different sizes, so byte hashes differ;
  // this is what stops unchanged profile pictures being stored again.
  visualHash     String?
  createdAt      DateTime @default(now())

  @@index([userId, kind])
  @@index([targetId, kind, contentHash])
  @@map("stored_files")
}

// Licensed music and sound effects the user curated (Pixabay, CC0 Freesound…).
// Reels only ever use sounds from here, never the trending reel's audio.
model SoundAsset {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // MUSIC | SFX
  kind          String
  title         String
  source        String?
  licenseUrl    String?
  moodTags      String[] @default([])
  bpm           Int?
  // low | medium | high
  energy        String?
  description   String?
  durationMs    Int
  storageUrl    String
  storageFileId String
  createdAt     DateTime @default(now())

  @@index([userId, kind])
  @@map("sound_assets")
}

model NicheAccount {
  id        String   @id @default(cuid())
  nicheId   String
  niche     Niche    @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  targetId  String
  target    Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  // USER (typed in) | SUGGESTED (picked from Gemini's suggestions)
  source    String   @default("USER")
  createdAt DateTime @default(now())

  @@unique([nicheId, targetId])
  @@index([targetId])
  @@map("niche_accounts")
}

model Target {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  username            String
  normalizedUsername  String
  externalId          String?
  accountType         TargetAccountType @default(UNKNOWN)
  eligibility         TargetEligibility @default(UNSUPPORTED)
  status              TargetStatus      @default(DISCOVERED)
  errorCode           String?
  errorMessage        String?
  nextRunAt           DateTime?
  lastCheckedAt       DateTime?
  lastSuccessAt       DateTime?
  consecutiveFailures Int               @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  monitor   Monitor?
  snapshots TargetSnapshot[]
  media     Media[]
  events    Event[]
  jobs      Job[]
  nicheAccounts NicheAccount[]
  storedFiles   StoredFile[]

  @@unique([userId, normalizedUsername])
  @@index([userId])
  @@index([status, nextRunAt])
  @@map("targets")
}

model InstagramSession {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  username           String
  authMethod         String    @default("COOKIE_IMPORT")
  encryptedCookies   String
  encryptedCookiesIv String
  userAgent          String?
  deviceId           String?
  impersonateTarget  String    @default("auto")
  proxyUrl           String?
  status             String    @default("ACTIVE")
  lastTestedAt       DateTime?
  lastSuccessAt      DateTime?
  lastErrorMessage   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastUsedAt         DateTime?
  cooldownUntil      DateTime?

  monitors Monitor[]

  @@index([userId])
  @@index([userId, status, lastUsedAt])
  @@map("instagram_sessions")
}

model Monitor {
  id                     String            @id @default(cuid())
  targetId               String            @unique
  target                 Target            @relation(fields: [targetId], references: [id], onDelete: Cascade)
  userId                 String
  engineType             String            @default("STEALTH_SCRAPER")
  triggerMode            String            @default("NEW_POSTS_ONLY")
  // MONITOR = a watched account (events, uploads, notifications).
  // TREND = a niche account watched only for trend data: no uploads, no events.
  purpose                String            @default("MONITOR")
  watchNewMedia          Boolean           @default(true)
  watchProfile           Boolean           @default(true)
  watchFollowerCount     Boolean           @default(false)
  watchFollowingCount    Boolean           @default(false)
  watchStories           Boolean           @default(true)
  watchReels             Boolean           @default(true)
  watchFollowerChurn     Boolean           @default(false)
  watchCollabPosts       Boolean           @default(true)
  autoRepost             Boolean           @default(false)
  jitterEnabled          Boolean           @default(true)
  humanSimEnabled        Boolean           @default(false)
  restrictedHoursEnabled Boolean           @default(false)
  restrictedHoursStart   Int               @default(8)
  restrictedHoursEnd     Int               @default(23)
  instagramSessionId     String?
  instagramSession       InstagramSession? @relation(fields: [instagramSessionId], references: [id], onDelete: SetNull)
  followerThreshold      Int?
  intervalSeconds        Int               @default(5400)
  active                 Boolean           @default(true)
  notificationChannelIds String[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([instagramSessionId])
  @@map("monitors")
}

model TargetSnapshot {
  id                       String    @id @default(cuid())
  targetId                 String
  target                   Target    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  capturedAt               DateTime  @default(now())
  username                 String
  name                     String?
  biography                String?
  website                  String?
  profilePictureUrl        String?
  profilePictureStorageUrl String?
  profilePictureStorageId  String?
  followersCount           Int?
  followsCount             Int?
  mediaCount               Int?
  reelsCount               Int?
  hasStory                 Boolean   @default(false)
  storiesCount             Int?
  latestMediaId            String?
  latestMediaTimestamp     DateTime?
  followersListHash        String?
  followingListHash        String?
  followersListJson        Json?
  followingListJson        Json?
  rawHash                  String

  @@index([targetId, capturedAt])
  @@map("target_snapshots")
}

model Media {
  id              String    @id @default(cuid())
  targetId        String
  target          Target    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  externalMediaId String
  mediaType       String
  permalink       String?
  timestamp       DateTime?
  caption         String?
  mediaUrl        String?
  videoUrl        String?
  sourceMediaUrl  String?
  sourceVideoUrl  String?
  storageUrl      String?
  storageFileId   String?
  storedAt        DateTime?
  thumbnailUrl    String?
  thumbnailFileId String?
  isExpired       Boolean   @default(false)
  expiredAt       DateTime?
  isStory         Boolean   @default(false)
  isCollab        Boolean   @default(false)
  collaborators   String[]  @default([])
  firstSeenAt     DateTime  @default(now())
  // Engagement, only collected for niche accounts on logged-in checks.
  playCount        Int?
  likeCount        Int?
  commentCount     Int?
  audioTitle       String?
  audioArtist      String?
  audioIsOriginal  Boolean?
  metricsUpdatedAt DateTime?
  metricSnapshots  MediaMetricSnapshot[]

  @@unique([targetId, externalMediaId])
  @@index([targetId])
  @@index([isExpired, storedAt])
  @@map("media")
}

model Event {
  id          String      @id @default(cuid())
  targetId    String
  target      Target      @relation(fields: [targetId], references: [id], onDelete: Cascade)
  userId      String
  type        EventType
  fingerprint String
  before      Json?
  after       Json?
  detectedAt  DateTime    @default(now())
  processedAt DateTime?
  status      EventStatus @default(PENDING)

  notifications Notification[]

  @@unique([targetId, fingerprint])
  @@index([userId, detectedAt])
  @@index([targetId, detectedAt])
  @@map("events")
}

enum NotificationProvider {
  DISCORD
  NTFY
  WEBHOOK
  WEBPUSH
}

model NotificationChannel {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  provider          NotificationProvider
  encryptedConfig   String
  encryptedConfigIv String
  eventTypeFilter   EventType[]
  cooldownSeconds   Int                  @default(0)
  enabled           Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  notifications Notification[]

  @@index([userId])
  @@map("notification_channels")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

model Notification {
  id            String               @id @default(cuid())
  eventId       String
  event         Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channelId     String
  channel       NotificationChannel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  provider      NotificationProvider
  status        NotificationStatus   @default(PENDING)
  attempts      Int                  @default(0)
  nextAttemptAt DateTime?
  sentAt        DateTime?
  error         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([eventId, channelId])
  @@index([status, nextAttemptAt])
  @@index([channelId])
  @@map("notifications")
}

model Job {
  id            String    @id @default(cuid())
  type          JobType
  targetId      String?
  target        Target?   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  status        JobStatus @default(QUEUED)
  attempts      Int       @default(0)
  runAt         DateTime  @default(now())
  lockedAt      DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  lastError     String?
  resultSummary String?

  @@index([type, status, runAt])
  @@index([targetId])
  @@map("jobs")
}

model AuthRateLimit {
  id           String    @id @default(cuid())
  key          String
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts     Int       @default(1)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?

  @@unique([key])
  @@map("auth_rate_limits")
}

model R2UsageCounter {
  id               String    @id @default("singleton")
  billingMonth     String
  aClassOps        Int       @default(0)
  bClassOps        Int       @default(0)
  storageBytesEst  BigInt    @default(0)
  lastReconciledAt DateTime?
  updatedAt        DateTime  @updatedAt

  @@map("r2_usage_counters")
}

model ScrapeThrottle {
  id                   String    @id
  day                  String
  profileViews         Int       @default(0)
  consecutiveSoftFails Int       @default(0)
  pauseLevel           Int       @default(0)
  pausedUntil          DateTime?
  updatedAt            DateTime  @updatedAt

  @@map("scrape_throttle")
}

model Repost {
  id               String   @id @default(cuid())
  userId           String
  sourceMediaId    String?
  sessionId        String
  status           String   @default("PENDING")
  instagramMediaId String?
  caption          String?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([sourceMediaId, sessionId])
  @@map("reposts")
}
